# Mercado Libre credentials — get from https://developers.mercadolibre.com.ar/apps
ML_CLIENT_ID=your_client_id_here
ML_CLIENT_SECRET=your_client_secret_here

# OAuth redirect URI registered in your ML app
ML_REDIRECT_URI=https://your-domain.com/api/auth/callback
ML_AUTH_URL=https://auth.mercadolibre.com.ar/authorization
ML_TOKEN_URL=https://api.mercadolibre.com/oauth/token
ML_API_BASE=https://api.mercadolibre.com

# External APIs
DOLLAR_BLUE_API=https://dolarapi.com/v1/dolares/blue

# Worker sync interval in ms (default: 5 min)
SYNC_INTERVAL_MS=300000